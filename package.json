{
  "name": "claude-national-golf",
  "version": "1.0.0",
  "private": true,
  "description": "Online multiplayer golf \u2014 twelve courses, nine holes each, no sign-up",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tools/test-server.mjs && npm run verify:bundle",
    "test:physics": "GOLF_DATA_DIR=.test-data node test/physics.mjs",
    "test:server": "GOLF_DATA_DIR=.test-data node test/server-hardening.mjs",
    "test:resilience": "GOLF_DATA_DIR=.test-data node test/resilience.mjs",
    "test:round": "GOLF_DATA_DIR=.test-data node test/round.mjs",
    "share": "node share.mjs",
    "test:cart": "GOLF_DATA_DIR=.test-data node test/cart.mjs",
    "verify:bundle": "node tools/verify-bundle.mjs",
    "build:portal": "node tools/build-portal.mjs",
    "test:portal": "GOLF_DATA_DIR=.test-data node --test test/portal.test.mjs",
    "migrate:db": "node tools/migrate-db.mjs",
    "check:db": "node tools/check-db.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "three": "^0.169.0"
  },
  "type": "module",
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
